{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --enforce-required-fields --force",
    "check-types": "tsc --noEmit",
    "type": "sanity schema extract --enforce-required-fields --force && sanity typegen generate && pnpm --filter @workspace/sanity format",
    "seed:shopify": "tsx scripts/seed-shopify/index.ts",
    "migrate:handoff": "tsx scripts/migrate-handoff/index.ts",
    "verify:shopify": "tsx scripts/verify-shopify.ts",
    "postinstall": "sanity exec scripts/cli-alert-for-data.ts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/assist": "6.1.17",
    "@sanity/client": "catalog:",
    "@sanity/color-input": "6.1.1",
    "@sanity/functions": "^1.8.0",
    "@sanity/icons": "^3.8.0",
    "@sanity/orderable-document-list": "2.0.18",
    "@sanity/ui": "^3.5.5",
    "@sanity/uuid": "^3.0.3",
    "@sanity/vision": "6.9.1",
    "@workspace/logger": "workspace:*",
    "dotenv": "^17.4.2",
    "friendlier-words": "^1.2.0",
    "lodash.get": "^4.4.2",
    "lucide-react": "catalog:",
    "pluralize-esm": "^9.0.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-asset-source-unsplash": "7.0.21",
    "sanity-plugin-hotspot-array": "5.0.12",
    "sanity-plugin-lucide-icon-picker": "1.0.3",
    "sanity-plugin-media": "6.1.1",
    "slugify": "^1.6.9",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@sanity/blueprints": "0.24.0",
    "@types/lodash.get": "^4.4.9",
    "@types/react": "catalog:",
    "@types/styled-components": "^5.1.36",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vite-plugin-tsconfig-paths": "^1.4.1"
  }
