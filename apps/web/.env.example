NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-29
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ISO 4217 code used to format prices (e.g. in OG images)
NEXT_PUBLIC_STORE_CURRENCY=GBP

# Canonical origin, no trailing slash. Required off Vercel, or every canonical
# and sitemap entry ships as localhost:3000. Commented out on purpose: it is
# checked BEFORE the Vercel vars, so a copied value pins production to localhost.
# Leave it unset for local sign-in: `pnpm dev:tunnel` sets it to your ngrok
# domain for that run.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Customer accounts (/account, sign-in). Optional: the feature is off until
# both are set. Client id: Shopify admin → Sales channels → Headless → your
# storefront → Customer Account API (public client). Secret: any 32+ random
# characters, e.g. `openssl rand -base64 32`; rotating it signs everyone out.
# Sign-in needs HTTPS: run `pnpm dev:tunnel` locally (README → Customer Accounts).
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# CUSTOMER_SESSION_SECRET=

# Optional, `pnpm dev:tunnel` only: a specific ngrok domain (custom or paid).
# Unset, it uses your ngrok account's dev domain, which does not change.
# NGROK_URL=
